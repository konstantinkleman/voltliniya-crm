# Скопируйте в .env и заполните
DOMAIN=crm.voltliniya.ru
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-long-random-string
# Первый пользователь-директор создаётся при старте, если его ещё нет
ADMIN_EMAIL=voltliniya@yandex.ru
ADMIN_PASSWORD=change-me
ADMIN_NAME=Константин
# Доля бригады от стоимости работ
CREW_SHARE=0.55
# Порты (на сервере рядом с другими проектами могут быть заняты)
HTTP_PORT=80
HTTPS_PORT=443
# Распознавание накладных по фото (OpenAI). Без ключа кнопка «По фото» в приходе скрыта
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Авито: чаты → CRM, бот-продажник, уведомления ---
# Ключи API: кабинет Авито для бизнеса → Интеграции (avito.ru/professionals/api). Нужна подписка «Расширенный» в Услугах.
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
# Любая длинная случайная строка — хвост адреса вебхука
AVITO_WEBHOOK_SECRET=
# 1 — бот отвечает клиентам сам; 0 — только заносит в CRM и уведомляет
AVITO_BOT_ENABLED=1
# Часы ответов бота по Москве (ночью — ответ утром в 9:00–9:40) и напоминания замолчавшим клиентам
AVITO_HOURS_START=9
AVITO_HOURS_END=21
AVITO_FOLLOWUP_ENABLED=1
# Telegram: тот же бот, что шлёт заявки с сайта (@Voltliniya_zayavki_bot); токен лежит на VDS в /opt/tg-relay/.env (TG_TOKEN),
# deploy.sh подставляет его сам. chat_id директора — 838171850.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=838171850
# Claude API для бота и еженедельного разбора чатов
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
